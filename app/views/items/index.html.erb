<div class="d-flex justify-content-between align-items-end mb-1">
  <h1 class="h3 mb-0">Item Database</h1>
  <span class="tk-mono text-secondary"><%= @total %> records<%= " · #{@items.size} shown" %></span>
</div>
<div class="text-secondary mb-4">Search the arsenal. Click an item to see every way to get it.</div>

<%= form_with url: items_path, method: :get, local: true, class: "row g-2 mb-4" do %>
  <div class="col-md-5">
    <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Item name…", autofocus: true %>
  </div>
  <div class="col-md-2">
    <%= select_tag :per,
          options_for_select([10, 25, 50, 100, 200], @per), class: "form-select", aria_label: "Items per page" %>
  </div>
  <div class="col-md-2">
    <%= select_tag :currency,
          options_for_select([["Any currency", ""], "RUB", "USD", "EUR"], params[:currency]),
          class: "form-select" %>
  </div>
  <div class="col-lg-3 d-flex gap-3 align-items-center flex-wrap">
    <div class="form-check"><%= check_box_tag :barter, "1", params[:barter] == "1", class: "form-check-input" %> <%= label_tag :barter, "Barter", class: "form-check-label" %></div>
    <div class="form-check"><%= check_box_tag :craft, "1", params[:craft] == "1", class: "form-check-input" %> <%= label_tag :craft, "Craft", class: "form-check-label" %></div>
    <div class="form-check"><%= check_box_tag :unlocked, "1", params[:unlocked] == "1", class: "form-check-input" %> <%= label_tag :unlocked, "Task-gated", class: "form-check-label" %></div>
  </div>
  <div class="col-md-2">
    <%= submit_tag "Filter", class: "btn btn-warning w-100 text-black" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="tk-label">
      <tr><th>Item</th><th>Buy price</th><th>Acquisition</th></tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td class="text-nowrap">
            <div class="d-flex align-items-center gap-2">
              <% if item.icon_link.present? %>
                <%= image_tag item.icon_link, size: "28x28", alt: "" %>
              <% end %>
              <%= link_to item.name, item_path(item), class: "link-light text-decoration-none" %>
            </div>
          </td>
          <td class="tk-mono">
            <% price = tk_money(item) %>
            <% if price %><span class="badge text-bg-success"><%= price %></span><% else %><span class="text-secondary">—</span><% end %>
          </td>
          <td>
            <% if item.require_unlock? %><span class="badge text-bg-accent me-1">task-gated</span><% end %>
            <% if item.barter? %><span class="badge text-bg-info me-1">barter</span><% end %>
            <% if item.craft? %><span class="badge text-bg-primary">craft</span><% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% if @items.empty? %>
  <p class="text-secondary">Nothing matches. Loosen the filters.</p>
<% end %>
<%= render "shared/pagination", total: @total, per: @per, page: @page %>
