<% children_map ||= {} %>
<li class="timeline-step <%= "final" if @unlock_task_ids.include?(task.id) %>">
  <span class="timeline-marker"></span>
  <div>
    <% if local_assigns[:label] %><span class="step-number"><%= label %></span><% end %>
    <%= link_to task.name, task_path(task), class: "link-light fw-bold" %>
    <% if task.wiki_link.present? %>
      <%= link_to "wiki ↗", task.wiki_link, class: "link-secondary small", target: "_blank" %>
    <% end %>
    <div class="small text-secondary">
      Given by <%= task.trader&.name || "unknown" %>
      <% if task.min_player_level.to_i.positive? %>
        · requires player level <%= task.min_player_level %>+
      <% end %>
      <% if @unlock_task_ids.include?(task.id) %>
        · <span class="text-accent">unlocks item</span>
      <% end %>
    </div>
  </div>
  <% kids = children_map[task.id] || [] %>
  <% if kids.any? %>
    <ul class="list-unstyled">
      <% kids.each do |child| %>
        <%= render "items/tree_node", task: child, children_map: children_map,
                     final: @unlock_task_ids.include?(child.id), label: nil %>
      <% end %>
    </ul>
  <% end %>
</li>
