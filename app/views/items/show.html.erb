<%= link_to "← All items", items_path, class: "link-secondary small" %>

<div class="d-flex align-items-center gap-3 my-3">
  <% if @item.icon_link.present? %>
    <%= image_tag @item.icon_link, size: "56x56", class: "rounded border border-secondary", alt: "" %>
  <% end %>
  <div>
    <h1 class="h3 mb-1"><%= @item.name %></h1>
    <div class="d-flex gap-2 align-items-center">
      <% if @item.price.present? %>
        <span class="badge text-bg-success fs-6"><%= number_with_delimiter(Integer(@item.price)) %> <%= @item.currency %></span>
      <% end %>
      <% if @item.require_unlock? %><span class="badge text-bg-accent">task-gated</span><% end %>
      <% if @item.barter? %><span class="badge text-bg-info">barterable</span><% end %>
      <% if @item.craft? %><span class="badge text-bg-primary">craftable</span><% end %>
    </div>
  </div>
  <div class="ms-auto">
    <%= link_to "Wiki ↗", @item.wiki_link, class: "btn btn-sm btn-outline-secondary", target: "_blank" if @item.wiki_link.present? %>
  </div>
</div>

<h2 class="h5 text-secondary mb-3">Requirements to unlock</h2>

<% if @conditions.any? %>
  <div class="mb-4 d-flex flex-wrap gap-2">
    <% @conditions.each do |condition| %>
      <div class="border border-secondary rounded px-3 py-2 condition-chip">
        <% if condition[:trader] %>
          <strong><%= condition[:trader] %></strong>
          <%= "LL#{condition[:loyalty]}" if condition[:loyalty] %>
        <% end %>
        <% if condition[:loyalty_cost] %>
          <span class="text-secondary small">
            (player level <%= condition[:loyalty_cost].required_player_level || "?" %>,
            reputation <%= condition[:loyalty_cost].required_reputation %>)
          </span>
        <% end %>
        <span class="text-secondary"><%= condition[:types].join(" / ") %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-secondary">No acquisition routes recorded for this item.</p>
<% end %>

<% if @chain.any? %>
  <div class="card bg-body-tertiary border-secondary">
    <div class="card-header d-flex justify-content-between">
      <span>Task chain</span>
      <% if @required_level.present? %>
        <span>total player level needed: <strong class="text-accent"><%= @required_level %></strong></span>
      <% end %>
    </div>
    <div class="card-body">
      <ol class="timeline list-unstyled mb-0">
        <% final_task = @chain.last %>
        <% @chain.each_with_index do |task, idx| %>
          <li class="timeline-step <%= "final" if task == final_task %>">
            <span class="timeline-marker"></span>
            <div>
              <span class="step-number text-secondary me-1"><%= idx + 1 %>.</span>
              <%= link_to task.name, task_path(task), class: "link-light fw-bold" %>
              <%= link_to "wiki ↗", task.wiki_link, class: "link-secondary small", target: "_blank" if task.wiki_link.present? %>
              <div class="small text-secondary">
                <%= task.trader&.name || "—" %>
                <% if task.min_player_level.to_i.positive? %>
                  · <span class="text-accent">level <%= task.min_player_level %>+</span>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ol>
      <p class="mt-3 mb-0 small text-secondary">
        Steps ordered from entry quest to the task that unlocks the item.
      </p>
    </div>
  </div>
<% elsif !@conditions.empty? %>
  <p class="text-secondary">No quest chain recorded — the unlock conditions above apply directly.</p>
<% end %>

<% if @compatible_guns.any? %>
  <h2 class="h5 text-secondary mt-4 mb-2">Compatible guns <span class="fs-6">(<%= @compatible_guns.size %>)</span></h2>
  <div class="d-flex flex-wrap gap-2">
    <% @compatible_guns.each do |gun| %>
      <%= link_to gun_path(gun), class: "text-decoration-none" do %>
        <span class="badge text-bg-secondary p-2"><%= gun.name %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @compatible_ammo.any? %>
  <h2 class="h5 text-secondary mt-4 mb-2">Compatible ammo <span class="fs-6">(<%= @compatible_ammo.size %>)</span></h2>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <tbody>
        <% @compatible_ammo.each do |ammo| %>
          <tr>
            <td><%= link_to ammo.name, item_path(ammo), class: "link-light text-decoration-none" %></td>
            <td class="text-end">
              <% if ammo.price.present? %>
                <span class="text-success"><%= number_with_delimiter(Integer(ammo.price)) %> <%= ammo.currency %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>