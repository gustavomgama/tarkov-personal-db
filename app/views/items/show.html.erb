<%= link_to "← All items", items_path, class: "link-secondary small" %>

<div class="d-flex align-items-center gap-3 my-3">
  <% if @item.icon_link.present? %>
    <%= image_tag @item.icon_link, size: "56x56", class: "rounded border border-secondary", alt: "" %>
  <% end %>
  <div>
    <h1 class="h3 mb-1"><%= @item.name %></h1>
    <div class="d-flex gap-2 align-items-center">
      <% if @item.price.present? %>
        <span class="badge text-bg-success fs-6"><%= number_with_delimiter(Integer(@item.price)) %> <%= @item.currency %></span>
      <% end %>
      <% if @item.require_unlock? %><span class="badge text-bg-warning">task-gated</span><% end %>
      <% if @item.barter? %><span class="badge text-bg-info">barterable</span><% end %>
      <% if @item.craft? %><span class="badge text-bg-primary">craftable</span><% end %>
    </div>
  </div>
  <div class="ms-auto">
    <%= link_to "Wiki ↗", @item.wiki_link, class: "btn btn-sm btn-outline-secondary", target: "_blank" if @item.wiki_link.present? %>
  </div>
</div>

<h2 class="h5 text-secondary mb-3">How to get it</h2>

<% routes = @routes %>

<% if routes.empty? %>
  <p class="text-secondary">No acquisition routes recorded for this item.</p>
<% end %>

<% routes.each_with_index do |route, index| %>
  <div class="card bg-body-tertiary border-secondary mb-4" id="route-<%= index %>">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div>
        <strong><%= route[:trader] || "Craft" %></strong>
        <% if route[:loyalty] %><span class="badge text-bg-warning ms-1">LL<%= route[:loyalty] %></span><% end %>
        <% if route[:loyalty_cost] %>
          <span class="text-secondary small ms-2">
            requires player level <%= route[:loyalty_cost].required_player_level || "?" %> ·
            reputation <%= route[:loyalty_cost].required_reputation %>
          </span>
        <% end %>
      </div>
      <div>
        <% route[:types].each do |type| %>
          <span class="badge text-bg-info"><%= type %></span>
        <% end %>
      </div>
    </div>

    <div class="card-body">
      <% if route[:task] %>
        <ol class="timeline list-unstyled mb-0">
          <% chain = (route[:prerequisites].map { |n| n[:task] } + [route[:task]]) %>
          <% chain.each_with_index do |task, idx| %>
            <li class="timeline-step <%= "final" if idx == chain.size - 1 %>">
              <span class="timeline-marker"></span>
              <div>
                <%= link_to task.name, task_path(task), class: "link-light fw-bold" %>
                <%= link_to "wiki ↗", task.wiki_link, class: "link-secondary small", target: "_blank" if task.wiki_link.present? %>
                <div class="small text-secondary">
                  <%= task.trader&.name || "—" %>
                  <% if task.min_player_level.to_i.positive? %>
                    · <span class="text-warning">level <%= task.min_player_level %>+</span>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ol>
        <% if route[:required_level].present? %>
          <p class="mt-3 mb-0">
            Total player level needed:
            <span class="badge text-bg-danger"><%= route[:required_level] %></span>
          </p>
        <% end %>
      <% else %>
        <p class="text-secondary mb-0">Unlocking task unknown — see wiki.</p>
      <% end %>
    </div>
  </div>
<% end %>

<% needed_for = Task.joins(:item_unlocks).where(item_unlocks: { item_id: @item.id }).distinct.order(:name) %>
<% if needed_for.any? %>
  <h2 class="h5 text-secondary mt-4 mb-2">Related tasks</h2>
  <ul class="list-unstyled">
    <% needed_for.each do |task| %>
      <li>• <%= link_to task.name, task_path(task), class: "link-light" %></li>
    <% end %>
  </ul>
<% end %>