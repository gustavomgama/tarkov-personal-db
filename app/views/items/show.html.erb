<%= link_to "← All items", items_path, class: "link-secondary small" %>

<div class="d-flex align-items-center gap-3 my-3 flex-wrap">
  <% if @item.icon_link.present? %>
    <%= image_tag @item.icon_link, size: "72x72", class: "rounded border border-secondary", alt: "" %>
  <% end %>
  <div>
    <h1 class="h3 mb-1"><%= @item.name %></h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
      <% price = tk_money(@item) %>
      <% if price %><span class="badge text-bg-success fs-6"><%= price %></span><% end %>
    </div>
  </div>
  <div class="ms-auto flex-shrink-0">
    <%= link_to "Wiki ↗", @item.wiki_link, class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener" if @item.wiki_link.present? %>
  </div>
</div>

<hr class="tk-rule" />

<section aria-labelledby="unlock-heading">
  <h2 id="unlock-heading" class="tk-label">How to unlock this item</h2>

  <% if @routes.empty? %>
    <p class="text-secondary mb-4">No acquisition routes recorded for this item.</p>
  <% else %>
    <p class="text-secondary mb-3">
      <%= @routes.size == 1 ? "There is one way to get it." : "There are #{@routes.size} ways to get it — easiest first." %>
    </p>

    <div class="route-stack">
      <% @routes.each_with_index do |route, index| %>
        <article class="route-card <%= "route-easiest" if index.zero? %>">
          <header class="route-head d-flex flex-wrap align-items-center gap-2">
            <span class="route-tag">Route <%= index + 1 %></span>
            <% if index.zero? && @routes.size > 1 %>
              <span class="badge text-bg-accent">easiest</span>
            <% end %>
            <span class="text-secondary small">
              <%= route[:tasks].empty? ? "No tasks required." : "#{route[:tasks].size} #{'task'.pluralize(route[:tasks].size)} to complete first." %>
            </span>
          </header>

          <ol class="route-steps list-unstyled mb-0">
            <% step_no = 0 %>
            <% route[:tasks].each do |task| %>
              <li class="route-step">
                <span class="step-num"><%= step_no += 1 %></span>
                <span class="step-body">
                  Complete <strong><%= link_to task.name, task_path(task), class: "link-light" %></strong>
                  <% if task.wiki_link.present? %>
                    <%= link_to "wiki ↗", task.wiki_link, class: "wiki-link", target: "_blank", rel: "noopener", "aria-label": "#{task.name} on the wiki" %>
                  <% end %>
                  <span class="text-secondary small d-block">
                    Given by <%= task.trader&.name || "unknown" %><%= " · requires player level #{task.min_player_level}+" if task.min_player_level.to_i.positive? %>
                  </span>
                </span>
              </li>
            <% end %>
            <li class="route-step route-step-final">
              <span class="step-num">✓</span>
              <span class="step-body">
                <% route[:traders].each_with_index do |t, i| %><% if i > 0 %> or <% end %>
                  <%= route[:actions].include?("barter") ? "Barter at" : "Buy from" %>
                  <strong><%= t[:name] %></strong><%= " at loyalty level #{t[:loyalty]}" if t[:loyalty] %>
                <% end %><%= "." if route[:traders].present? %>
                <% if route[:actions].include?("craft") %>
                  Craft it<%= " at the hideout" if route[:traders].empty? %>.
                <% end %>
              </span>
            </li>
          </ol>
        </article>
      <% end %>
    </div>
  <% end %>
</section>

<% if @compatible_guns.any? %>
  <section aria-labelledby="guns-heading" class="mt-4">
    <span id="guns-heading" class="tk-label mt-4 d-block">Compatible guns (<%= @compatible_guns.size %>)</span>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% @compatible_guns.each do |gun| %>
        <%= link_to item_path(gun), class: "chip-link" do %>
          <span class="badge text-bg-secondary p-2"><%= gun.name %></span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @compatible_ammo.any? %>
  <section aria-labelledby="ammo-heading" class="mt-4">
    <span id="ammo-heading" class="tk-label mt-4 d-block">Compatible ammunition (<%= @compatible_ammo.size %>)</span>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle">
        <tbody>
          <% @compatible_ammo.each do |ammo| %>
            <tr>
              <td><%= link_to ammo.name, item_path(ammo), class: "link-light text-decoration-none" %></td>
              <td class="text-end tk-mono"><%= tk_money(ammo) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
