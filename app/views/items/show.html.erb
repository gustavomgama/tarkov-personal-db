<%= link_to "← All items", items_path, class: "link-secondary small" %>

<div class="d-flex align-items-center gap-3 my-3 flex-wrap">
  <%= item_hero(@item) %>
  <div>
    <h1 class="h3 mb-1"><%= @item.name %></h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
      <% price = tk_money(@item) %>
      <% if price %><span class="badge text-bg-success fs-6"><%= price %></span><% end %>
      <% @item.categories&.each do |cat| %>
        <span class="badge text-bg-secondary"><%= Item::CATEGORIES.fetch(cat, cat) %></span>
      <% end %>
      <% if @item.penetration_power.present? %>
        <span class="badge text-bg-warning text-dark" title="Ammo penetration power">PP <%= @item.penetration_power %></span>
      <% end %>
      <% if @item.damage.present? %>
        <span class="badge text-bg-danger" title="Ammo damage"><%= @item.damage %> DMG</span>
      <% end %>
      <% if @item.armor_class.present? %>
        <span class="badge text-bg-info" title="Armor protection class">AC <%= @item.armor_class %></span>
      <% end %>
    </div>
  </div>
  <div class="ms-auto flex-shrink-0 d-flex gap-2">
    <%= dev_item_link(@item) %>
    <%= link_to "Wiki ↗", @item.wiki_link, class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener" if @item.wiki_link.present? %>
  </div>
</div>

<hr class="tk-rule" />

<section aria-labelledby="unlock-heading" class="mb-4">
  <h2 id="unlock-heading" class="tk-label">How to unlock this item</h2>

  <% if @routes.empty? %>
    <p class="text-secondary mb-4">No acquisition routes recorded for this item.</p>
  <% else %>
    <p class="text-secondary mb-3">
      <%= @routes.size == 1 ? "There is one way to get it." : "There are #{@routes.size} ways to get it — easiest first." %>
    </p>

    <div class="route-stack">
      <% @routes.each_with_index do |route, index| %>
        <article class="route-card <%= "route-easiest" if index.zero? %>">
          <header class="route-head d-flex flex-wrap align-items-center gap-2">
            <span class="route-tag">Route <%= index + 1 %></span>
            <% if index.zero? && @routes.size > 1 %>
              <span class="badge text-bg-accent">easiest</span>
            <% end %>
            <span class="text-secondary small">
              <%= route[:tasks].empty? ? "No tasks required." : "#{route[:tasks].size} #{'task'.pluralize(route[:tasks].size)} to complete first." %>
            </span>
          </header>

          <ol class="route-steps list-unstyled mb-0">
            <% step_no = 0 %>
            <% route[:tasks].each do |task| %>
              <li class="route-step">
                <span class="step-num"><%= step_no += 1 %></span>
                <span class="step-body">
                  Complete <strong><%= link_to task.name, task_path(task), class: "link-light" %></strong>
                  <span class="wiki-links ms-1">
                    <%= dev_task_link(task) %>
                    <%= link_to "wiki ↗", task.wiki_link, class: "link-secondary small ms-2", target: "_blank", rel: "noopener", "aria-label": "#{task.name} on the wiki" if task.wiki_link.present? %>
                  </span>
                  <span class="text-secondary small d-flex align-items-center gap-1 flex-wrap">
                    Given by
                    <% if task.trader %>
                      <%= link_to trader_path(task.trader), class: "trader-chip" do %>
                        <%= trader_avatar(task.trader, size: 20) %> <%= task.trader.name %>
                      <% end %>
                    <% else %>unknown<% end %>
                    <%= " · requires player level #{task.min_player_level}+" if task.min_player_level.to_i.positive? %>
                  </span>
                </span>
              </li>
            <% end %>

            <% route[:offers].each do |offer| %>
              <% badge_kind, badge_label = offer_badge(offer) %>
              <li class="route-step route-step-final offer-line offer-<%= offer[:type] %>">
                <span class="step-num"><%= step_no += 1 %>✓</span>
                <span class="step-body d-flex align-items-center gap-2 flex-wrap">
                  <span class="offer-type-badge badge text-bg-<%= badge_kind %>">
                    <%= badge_label %>
                  </span>
                  <% if offer[:trader] || offer[:unlock].trader_name.present? %>
                    <%= offer_verb(offer[:type]) %>
                    <span class="offer-trader d-inline-flex align-items-center gap-1">
                      <%= trader_avatar(offer[:trader] || offer[:unlock].trader_name, size: 28) %>
                      <%= trader_link(offer[:trader] || offer[:unlock].trader_name, class: "fw-bold") %>
                    </span>
                    <% if offer[:loyalty] %><span class="badge text-bg-warning">LL<%= offer[:loyalty] %></span><% end %>
                    <% variant = offer[:unlock].source_variant %>
                    <% if variant.present? %>
                      <span class="badge text-bg-dark border border-secondary"
                            title="This offer is for a specific build of the weapon, not the standard variant">
                        <%= variant %>
                      </span>
                    <% end %>
                    <% if offer[:required_items].any? %>
                      <%= render "items/offer_recipe", offer: offer %>
                    <% end %>
                  <% elsif offer[:type] == "reward" %>
                    <% reward_task = route[:tasks].last || offer[:unlock].task %>
                    <span>
                      Received as a reward for completing
                      <% if reward_task %><strong><%= link_to reward_task.name, task_path(reward_task), class: "link-light" %></strong><% else %>a task<% end %>.
                    </span>
                  <% elsif offer[:type] == "craft" %>
                    <% if offer[:station].present? %>
                      <span>Craft it at the
                        <strong><%= offer[:station] %></strong><%= " (level #{offer[:station_level]})" if offer[:station_level] %>.
                      </span>
                    <% else %>
                      <span>Craft it at the hideout.</span>
                    <% end %>
                    <% if offer[:required_items].any? %>
                      <%= render "items/offer_recipe", offer: offer %>
                    <% end %>
                  <% else %>
                    <span class="small text-secondary">Source unknown.</span>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ol>
        </article>
      <% end %>
    </div>
  <% end %>
</section>

<% if @compatibilities.any? %>
  <section aria-labelledby="compat-heading" class="mt-4">
    <h2 id="compat-heading" class="tk-label mt-4 d-block">Compatibility</h2>
    <% @compatibilities.each do |group| %>
      <div class="compat-group">
        <div class="fw-bold small text-accent"><%= group[:label] %></div>
        <% if group[:note] %>
          <p class="text-secondary mb-0"><%= group[:note] %></p>
        <% else %>
          <div class="d-flex flex-wrap gap-2 mt-1">
            <% group[:items].each do |related| %>
              <%= link_to item_path(related), class: "chip-link" do %>
                <span class="badge text-bg-secondary p-2"><%= related.name %><%= " · #{tk_money(related)}" if group[:show_price] && tk_money(related) %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
