<%= link_to "← All items", items_path, class: "link-secondary small" %>

<div class="d-flex align-items-center gap-3 my-3 flex-wrap">
  <% if @item.icon_link.present? %>
    <%= image_tag @item.icon_link, size: "72x72", class: "rounded border border-secondary", alt: "" %>
  <% end %>
  <div>
    <h1 class="h3 mb-1"><%= @item.name %></h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
      <% price = tk_money(@item) %>
      <% if price %><span class="badge text-bg-success fs-6"><%= price %></span><% end %>
      <% if @item.require_unlock? %><span class="badge text-bg-accent">task-gated</span><% end %>
      <% if @item.barter? %><span class="badge text-bg-info">barterable</span><% end %>
      <% if @item.craft? %><span class="badge text-bg-primary">craftable</span><% end %>
    </div>
  </div>
  <div class="ms-auto flex-shrink-0">
    <%= link_to "Wiki ↗", @item.wiki_link, class: "btn btn-sm btn-outline-secondary", target: "_blank" if @item.wiki_link.present? %>
  </div>
</div>

<h2 class="h5 text-secondary mb-3">Requirements to unlock</h2>

<% if @conditions.any? %>
  <div class="mb-4 d-flex flex-wrap gap-2">
    <% @conditions.each do |condition| %>
      <div class="condition-chip rounded px-3 py-1 d-flex align-items-center gap-2 flex-wrap">
        <span><%= tk_condition_text(condition) %></span>
        <% if condition[:task] %>
          <%= link_to condition[:task].name, task_path(condition[:task]), class: "link-accent small" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-secondary mb-4">No acquisition routes recorded for this item.</p>
<% end %>

<% if @chain.any? %>
  <div class="card bg-body-tertiary border-secondary mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span>Task chain — complete in order</span>
      <% if @required_level.present? %>
        <span class="text-secondary">player level <strong class="text-accent"><%= @required_level %></strong></span>
      <% end %>
    </div>
    <div class="card-body pt-3">
      <ol class="timeline list-unstyled mb-0">
        <% final_task = @chain.last %>
        <% @chain.each_with_index do |task, idx| %>
          <li class="timeline-step <%= "final" if task == final_task %>">
            <span class="timeline-marker"></span>
            <div>
              <div>
                <span class="step-number">STEP <%= idx + 1 %>/<%= @chain.size %></span>
                <%= link_to task.name, task_path(task), class: "link-light fw-bold" %>
                <%= link_to "wiki ↗", task.wiki_link, class: "link-secondary small", target: "_blank" if task.wiki_link.present? %>
              </div>
              <div class="small text-secondary">
                Given by <%= task.trader&.name || "unknown" %>
                <% if task.min_player_level.to_i.positive? %>
                  · requires player level <%= task.min_player_level %>+
                <% end %>
                <% if task == final_task %>
                  · <span class="text-accent">unlocks item</span>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
<% elsif !@conditions.empty? %>
  <p class="text-secondary">No quest chain recorded — the conditions above apply directly.</p>
<% end %>

<% if @compatible_guns.any? %>
  <span class="tk-label mt-4 d-block">Compatible guns (<%= @compatible_guns.size %>)</span>
  <div class="d-flex flex-wrap gap-2 mb-4">
    <% @compatible_guns.each do |gun| %>
      <%= link_to item_path(gun) do %>
        <span class="badge text-bg-secondary p-2"><%= gun.name %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @compatible_ammo.any? %>
  <span class="tk-label mt-4 d-block">Compatible ammunition (<%= @compatible_ammo.size %>)</span>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <tbody>
        <% @compatible_ammo.each do |ammo| %>
          <tr>
            <td><%= link_to ammo.name, item_path(ammo), class: "link-light text-decoration-none" %></td>
            <td class="text-end tk-mono"><%= tk_money(ammo) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>