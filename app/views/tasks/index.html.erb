<h1 class="h3 mb-3">Tasks <span class="text-secondary fs-6">(<%= @total %>)</span></h1>

<%= form_with url: tasks_path, method: :get, local: true, class: "row g-2 mb-4" do %>
  <div class="col-md-6">
    <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Search tasks...", autofocus: true %>
  </div>
  <div class="col-md-4">
    <%= select_tag :trader_id,
          options_from_collection_for_select(Trader.order(:name), :id, :name, params[:trader_id]),
          include_blank: "Any trader", class: "form-select" %>
  </div>
  <div class="col-md-2">
    <%= submit_tag "Filter", class: "btn btn-warning w-100" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr><th>Task</th><th>Trader</th><th>Level</th><th>Unlocks</th></tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= link_to task.name, task_path(task), class: "link-light text-decoration-none" %></td>
          <td><span class="text-secondary"><%= task.trader&.name || "—" %></span></td>
          <td><% if task.min_player_level.to_i.positive? %><span class="badge text-bg-danger"><%= task.min_player_level %>+</span><% end %></td>
          <td><% count = task.item_unlocks.count %><% if count.positive? %><span class="badge text-bg-primary"><%= count %></span><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>