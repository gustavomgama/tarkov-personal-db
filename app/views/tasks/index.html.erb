<div class="d-flex justify-content-between align-items-end mb-1">
  <h1 class="h3 mb-0">Tasks</h1>
  <span class="tk-mono text-secondary"><%= @total %> records<%= " · #{@tasks.length} shown" %></span>
</div>

<%= form_with url: tasks_path, method: :get, local: true, class: "row g-2 mb-4" do %>
  <div class="col-md-6">
    <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Task name…", autofocus: true %>
  </div>
  <div class="col-md-4">
    <%= select_tag :trader_id,
          options_from_collection_for_select(Trader.order(:name), :id, :name, params[:trader_id]),
          include_blank: "Any trader", class: "form-select" %>
  </div>
  <div class="col-md-2">
    <%= submit_tag "Filter", class: "btn btn-warning w-100 text-black" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="tk-label">
      <tr><th>Task</th><th>Given by</th><th>Level</th><th>Gates</th></tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= link_to task.name, task_path(task), class: "link-light text-decoration-none" %></td>
          <td><span class="text-secondary"><%= task.trader&.name || "—" %></span></td>
          <td><% if task.min_player_level.to_i.positive? %><span class="badge text-bg-danger"><%= task.min_player_level %>+</span><% end %></td>
          <td class="tk-mono"><% count = task.unlocks_count.to_i %><% if count.positive? %><span class="badge text-bg-primary"><%= count %> <%= "item".pluralize(count) %></span><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination", total: @total, per: 50, page: @page %>
