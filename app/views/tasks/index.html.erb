<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Tasks</h1>
    <span class="text-sm text-gray-500 dark:text-gray-400"><%= @task_count %> total</span>
  </div>

  <div class="space-y-2">
    <% @tasks.each do |task| %>
      <%= link_to task_path(task), class: "block bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:border-blue-500 dark:hover:border-blue-400 transition-colors" do %>
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-semibold"><%= task.full_name %></h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              <%= task.given_by %> ·
              <% if task.kappa_required %>
                <span class="text-yellow-500">Kappa Required</span>
              <% else %>
                No Kappa
              <% end %>
            </p>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
