<% pages = (total.to_f / per).ceil %>
<% page = [ [ page, 1 ].max, pages ].min %>
<% if pages > 1 %>
  <% window = ([page - 2, 1].max..[page + 2, pages].min).to_a %>
  <nav class="d-flex justify-content-between align-items-center my-4" aria-label="Pages">
    <span class="tk-mono text-secondary">page <%= page %> / <%= pages %></span>
    <div class="btn-group" role="group">
      <% if page > 1 %>
        <%= link_to "◂ Prev", request.query_parameters.merge(page: page - 1),
              class: "btn btn-sm btn-outline-secondary", rel: "prev", "aria-label": "Previous page" %>
      <% end %>
      <% window.each do |n| %>
        <%= link_to n, request.query_parameters.merge(page: n),
              class: "btn btn-sm #{n == page ? "btn-warning text-black" : "btn-outline-secondary"}",
              "aria-label": "Page #{n}", "aria-current": (n == page ? "page" : nil) %>
      <% end %>
      <% if page < pages %>
        <%= link_to "Next ▸", request.query_parameters.merge(page: page + 1),
              class: "btn btn-sm btn-outline-secondary", rel: "next", "aria-label": "Next page" %>
      <% end %>
    </div>
  </nav>
<% end %>
