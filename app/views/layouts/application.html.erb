<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title>Tarkov Personal DB</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "bootstrap.min", "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom mb-4">
      <div class="container">
        <%= link_to "Tarkov DB", root_path, class: "navbar-brand fw-bold text-warning" %>
        <ul class="navbar-nav flex-row gap-3">
          <li class="nav-item"><%= link_to "Items", items_path, class: "nav-link" %></li>
          <li class="nav-item"><span class="nav-link disabled">Tasks</span></li>
          <li class="nav-item"><span class="nav-link disabled">Traders</span></li>
          <li class="nav-item"><span class="nav-link disabled">Hideout</span></li>
        </ul>
      </div>
    </nav>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
