<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} // TARKOV DB" : "Tarkov Unlock Navigator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Escape from Tarkov item, task and trader unlock reference." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "bootstrap.min", "application" %>
    <%= javascript_importmap_tags %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  </head>
  <body>
    <% flash.each do |type, message| %>
      <div class="alert <%= type == "notice" ? "alert-success" : "alert-danger" %> mb-0" role="alert">
        <%= message %>
      </div>
    <% end %>


    <footer class="container pb-5">
      <div class="tk-mono text-secondary small">
        data:
        <%= link_to "tarkov.dev", "https://tarkov.dev", class: "link-secondary", target: "_blank", rel: "noopener" %> ·
        <%= link_to "Escape from Tarkov Wiki (fandom)", "https://escapefromtarkov.fandom.com", class: "link-secondary", target: "_blank", rel: "noopener" %> ·
        <%= link_to "tarkov-market.com", "https://tarkov-market.com", class: "link-secondary", target: "_blank", rel: "noopener" %>
      </div>
    </footer>
  </body>
</html>
