<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <title>Tarkov DB — Unlock Navigator</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "bootstrap.min", "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg mb-4">
      <div class="container">
        <%= link_to "TARKOV // DB", root_path, class: "navbar-brand" %>
        <ul class="navbar-nav flex-row gap-3">
          <li class="nav-item"><%= link_to "Items", items_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Tasks", tasks_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Traders", traders_path, class: "nav-link" %></li>
        </ul>
      </div>
    </nav>
    <main class="container pb-5">
      <%= yield %>
    </main>
  </body>
</html>